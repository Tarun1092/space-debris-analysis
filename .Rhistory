# ==============================================================================
# OrbitalGuard AI - 3D Earth & Space Debris Interactive Visualizer (R Version)
# Reads the CSV catalog and renders an interactive 3D Earth Globe with
# orbiting satellites, space debris, and spent rocket bodies using Plotly in R.
# ==============================================================================
library(plotly)
library(dplyr)
library(htmlwidgets)
# 1. Read the Space Debris CSV Dataset
csv_path <- "data/space_debris_catalog.csv"
if (!file.exists(csv_path)) {
stop("CSV file not found! Please run preprocess_debris_data.R first.")
}
cat("Reading space debris catalog from:", csv_path, "\n")
df <- read.csv(csv_path, stringsAsFactors = FALSE)
cat(sprintf("Loaded %d tracked space objects.\n", nrow(df)))
# 2. Physics: Convert Keplerian Orbital Elements to 3D Cartesian Coordinates
EARTH_RADIUS_KM <- 6371.0
# Calculate mean altitude and scaled radial distance
df <- df %>%
mutate(
mean_alt_km = (perigee_km + apogee_km) / 2.0,
r_units = 1.0 + (mean_alt_km / EARTH_RADIUS_KM), # Earth radius = 1.0
# Angles in Radians
inc_rad = inclination_deg * (pi / 180.0),
raan_rad = raan_deg * (pi / 180.0),
argp_rad = arg_perigee_deg * (pi / 180.0),
mean_anom_rad = mean_anomaly_deg * (pi / 180.0),
u_rad = argp_rad + mean_anom_rad,
# Orbital Plane Coordinates
x_orb = r_units * cos(u_rad),
y_orb = r_units * sin(u_rad),
# Rotate to Earth-Centered Inertial (ECI) 3D Cartesian Coordinates
x = x_orb * cos(raan_rad) - y_orb * sin(raan_rad) * cos(inc_rad),
y = x_orb * sin(raan_rad) + y_orb * cos(raan_rad) * cos(inc_rad),
z = y_orb * sin(inc_rad)
)
# Format Hover Tooltip Text
df <- df %>%
mutate(
hover_text = sprintf(
"<b>%s</b><br>NORAD ID: #%d<br>Type: %s<br>Nation: %s<br>Orbit: %s<br>Altitude: %.1f km<br>Velocity: %.2f km/s<br>Period: %.1f min",
name, norad_id, object_type, country, orbit_type, mean_alt_km, velocity_km_s, period_min
)
)
# 3. Generate 3D Earth Surface Sphere Mesh
lat_seq <- seq(-pi / 2, pi / 2, length.out = 60)
lon_seq <- seq(0, 2 * pi, length.out = 120)
grid <- expand.grid(lon = lon_seq, lat = lat_seq)
earth_x <- matrix(cos(grid$lat) * cos(grid$lon), nrow = 60, ncol = 120, byrow = TRUE)
earth_y <- matrix(cos(grid$lat) * sin(grid$lon), nrow = 60, ncol = 120, byrow = TRUE)
earth_z <- matrix(sin(grid$lat), nrow = 60, ncol = 120, byrow = TRUE)
# Realistic earth ocean/continent altitude texture matrix
elevation <- sin(3 * earth_x) * cos(3 * earth_y) + cos(2 * earth_z)
# 4. Build 3D Plotly Figure
fig <- plot_ly()
# Trace 1: 3D Earth Globe Surface
earth_colorscale <- list(
list(0.00, "#040b1e"), # Deep Ocean
list(0.40, "#0a2356"), # Shallow Waters
list(0.55, "#1c4294"), # Coastal Shelf
list(0.65, "#2d5a27"), # Vegetation Landmass
list(0.85, "#c47a33"), # Deserts
list(1.00, "#e6f2ff")  # Polar Ice
)
fig <- fig %>%
add_surface(
x = earth_x,
y = earth_y,
z = earth_z,
surfacecolor = elevation,
colorscale = earth_colorscale,
showscale = FALSE,
name = "Earth (Radius = 6,371 km)",
hoverinfo = "none",
opacity = 0.98,
lighting = list(ambient = 0.8, diffuse = 0.9, specular = 0.2)
)
# Subset objects by category
df_satellites <- df %>% filter(object_type == "PAYLOAD" & country != "IND")
df_isro <- df %>% filter(country == "IND")
df_debris <- df %>% filter(object_type == "DEBRIS")
df_rockets <- df %>% filter(object_type == "ROCKET BODY")
# Trace 2: Active Satellites (Cyan)
if (nrow(df_satellites) > 0) {
fig <- fig %>%
add_trace(
data = df_satellites,
x = ~x, y = ~y, z = ~z,
type = "scatter3d",
mode = "markers",
marker = list(size = 3.5, color = "#00e5ff", opacity = 0.85),
name = sprintf("Active Satellites (%d)", nrow(df_satellites)),
text = ~hover_text,
hoverinfo = "text"
)
}
# Trace 3: ISRO Assets (Orange Beacon)
if (nrow(df_isro) > 0) {
fig <- fig %>%
add_trace(
data = df_isro,
x = ~x, y = ~y, z = ~z,
type = "scatter3d",
mode = "markers",
marker = list(size = 5.0, color = "#ff9933", symbol = "diamond", opacity = 0.95),
name = sprintf("ISRO Assets (%d)", nrow(df_isro)),
text = ~hover_text,
hoverinfo = "text"
)
}
# Trace 4: Space Debris (Neon Pink / Red)
if (nrow(df_debris) > 0) {
fig <- fig %>%
add_trace(
data = df_debris,
x = ~x, y = ~y, z = ~z,
type = "scatter3d",
mode = "markers",
marker = list(size = 2.5, color = "#ff2a6d", opacity = 0.80),
name = sprintf("Space Debris (%d)", nrow(df_debris)),
text = ~hover_text,
hoverinfo = "text"
)
}
# Trace 5: Spent Rocket Bodies (Amber Yellow)
if (nrow(df_rockets) > 0) {
fig <- fig %>%
add_trace(
data = df_rockets,
x = ~x, y = ~y, z = ~z,
type = "scatter3d",
mode = "markers",
marker = list(size = 3.8, color = "#ffb703", opacity = 0.90),
name = sprintf("Spent Rocket Bodies (%d)", nrow(df_rockets)),
text = ~hover_text,
hoverinfo = "text"
)
}
# 5. Styling & 3D Camera Layout
fig <- fig %>%
layout(
title = list(
text = "<b>OrbitalGuard AI: 3D Earth Space Debris Visualizer (R Version)</b><br><sup>Visualizing Satellites & Space Debris from CSV Dataset</sup>",
font = list(color = "#00e5ff", size = 18, family = "sans-serif")
),
paper_bgcolor = "#070913",
plot_bgcolor = "#070913",
scene = list(
xaxis = list(visible = FALSE, showgrid = FALSE),
yaxis = list(visible = FALSE, showgrid = FALSE),
zaxis = list(visible = FALSE, showgrid = FALSE),
bgcolor = "#070913",
aspectmode = "data",
camera = list(
eye = list(x = 1.6, y = 1.6, z = 1.2)
)
),
legend = list(
font = list(color = "#f0f4fc", size = 12),
bgcolor = "rgba(14, 18, 36, 0.85)",
bordercolor = "rgba(64, 93, 148, 0.5)",
borderwidth = 1
)
)
# 6. Save Interactive HTML Widget
output_html <- "r_debris_globe_3d.html"
cat("Saving interactive 3D Earth Globe widget to:", output_html, "\n")
saveWidget(fig, output_html, selfcontained = FALSE)
cat("Successfully generated 3D Earth visualizer!\n")
cat("Open", output_html, "in your web browser to view the interactive 3D globe.\n")
# ==============================================================================
# OrbitalGuard AI - Space Debris Analytics & Statistics Dashboard (R Version)
# Performs statistical analysis and generates publication-grade visualizations
# using ggplot2, dplyr, and plotly from the CSV dataset.
# ==============================================================================
library(ggplot2)
library(dplyr)
library(plotly)
library(htmlwidgets)
# Create figures output directory
dir.create("figures", showWarnings = FALSE)
# 1. Read the Space Debris CSV Dataset
csv_path <- "data/space_debris_catalog.csv"
if (!file.exists(csv_path)) {
stop("CSV file not found! Please run preprocess_debris_data.R first.")
}
cat("Reading space debris catalog from:", csv_path, "\n")
df <- read.csv(csv_path, stringsAsFactors = FALSE)
# Compute mean altitude
df <- df %>% mutate(mean_alt_km = (perigee_km + apogee_km) / 2.0)
# ==============================================================================
# 2. Key Summary Statistics
# ==============================================================================
total_objs <- nrow(df)
active_payloads <- sum(df$object_type == "PAYLOAD")
debris_count <- sum(df$object_type == "DEBRIS")
rocket_count <- sum(df$object_type == "ROCKET BODY")
isro_count <- sum(df$country == "IND")
leo_count <- sum(df$orbit_type == "LEO")
cat("\n=======================================================\n")
cat("          SPACE DEBRIS ANALYTICS REPORT                \n")
cat("=======================================================\n")
cat(sprintf("Total Cataloged Space Objects: %d\n", total_objs))
cat(sprintf("Active Satellite Payloads:     %d (%.1f%%)\n", active_payloads, (active_payloads / total_objs) * 100))
cat(sprintf("Tracked Space Debris Pieces:   %d (%.1f%%)\n", debris_count, (debris_count / total_objs) * 100))
cat(sprintf("Spent Rocket Bodies:           %d (%.1f%%)\n", rocket_count, (rocket_count / total_objs) * 100))
cat(sprintf("ISRO (India) Tracked Assets:   %d\n", isro_count))
cat(sprintf("LEO Regime Objects (<2,000 km):%d (%.1f%%)\n", leo_count, (leo_count / total_objs) * 100))
cat("=======================================================\n\n")
# Dark Theme for ggplot2
theme_space <- theme_minimal(base_size = 12) +
theme(
plot.background = element_rect(fill = "#070913", color = NA),
panel.background = element_rect(fill = "#0b122e", color = NA),
panel.grid.major = element_line(color = "#1c2545"),
panel.grid.minor = element_line(color = "#121830"),
text = element_text(color = "#f0f4fc"),
axis.text = element_text(color = "#8e9bb4"),
axis.title = element_text(color = "#00e5ff", face = "bold"),
plot.title = element_text(color = "#00e5ff", face = "bold", size = 14),
plot.subtitle = element_text(color = "#8e9bb4", size = 10),
legend.background = element_rect(fill = "#0e1224", color = "#253459"),
legend.text = element_text(color = "#f0f4fc"),
legend.title = element_text(color = "#00e5ff")
)
# ==============================================================================
# Plot 1: Altitude Spatial Density Distribution (LEO: 0 - 2,000 km)
# ==============================================================================
cat("Generating Plot 1: Altitude Spatial Density Distribution...\n")
df_leo <- df %>% filter(mean_alt_km <= 2000)
p1 <- ggplot(df_leo, aes(x = mean_alt_km, fill = object_type)) +
geom_histogram(binwidth = 50, color = "#070913", alpha = 0.85) +
scale_fill_manual(
values = c("PAYLOAD" = "#00e5ff", "DEBRIS" = "#ff2a6d", "ROCKET BODY" = "#ffb703", "UNKNOWN" = "#8e9bb4")
) +
labs(
title = "Space Object Spatial Density across Low Earth Orbit (LEO)",
subtitle = "Peak crowding observed in Sun-Synchronous Polar Shells (750 - 900 km)",
x = "Mean Orbital Altitude (km)",
y = "Cataloged Object Count",
fill = "Object Category"
) +
theme_space
ggsave("figures/altitude_spatial_density.png", p1, width = 9, height = 5, dpi = 300)
# ==============================================================================
# Plot 2: Object Type Breakdown (Bar Chart)
# ==============================================================================
cat("Generating Plot 2: Distribution by Object Type...\n")
type_summary <- df %>%
group_by(object_type) %>%
summarise(Count = n(), .groups = "drop") %>%
mutate(Percentage = round((Count / sum(Count)) * 100, 1))
p2 <- ggplot(type_summary, aes(x = reorder(object_type, -Count), y = Count, fill = object_type)) +
geom_bar(stat = "identity", width = 0.6) +
geom_text(aes(label = sprintf("%d (%s%%)", Count, Percentage)), vjust = -0.4, color = "#f0f4fc", fontface = "bold", size = 3.5) +
scale_fill_manual(
values = c("PAYLOAD" = "#00e5ff", "DEBRIS" = "#ff2a6d", "ROCKET BODY" = "#ffb703", "UNKNOWN" = "#8e9bb4")
) +
labs(
title = "Orbital Object Population Breakdown",
subtitle = "Debris fragments constitute over 65% of all cataloged objects in orbit",
x = "Object Classification",
y = "Count"
) +
theme_space +
theme(legend.position = "none")
ggsave("figures/object_type_breakdown.png", p2, width = 8, height = 5, dpi = 300)
# ==============================================================================
# Plot 3: Space Objects Share by Country / Agency
# ==============================================================================
cat("Generating Plot 3: Country Share Distribution...\n")
country_summary <- df %>%
group_by(country) %>%
summarise(Count = n(), .groups = "drop") %>%
arrange(desc(Count))
p3 <- ggplot(country_summary, aes(x = reorder(country, -Count), y = Count, fill = country)) +
geom_bar(stat = "identity", fill = "#7c4dff", width = 0.6) +
geom_text(aes(label = Count), vjust = -0.4, color = "#f0f4fc", size = 3.2) +
labs(
title = "Catalog Share by Nation / Space Agency",
subtitle = "Analysis of space actors contributing to active satellites and debris",
x = "Nation / Space Agency",
y = "Tracked Objects"
) +
theme_space
ggsave("figures/country_share_distribution.png", p3, width = 9, height = 5, dpi = 300)
# ==============================================================================
# Plot 4: Orbital Velocity vs. Altitude (Keplerian Physics Verification)
# ==============================================================================
cat("Generating Plot 4: Orbital Velocity vs Altitude...\n")
p4 <- ggplot(df, aes(x = mean_alt_km, y = velocity_km_s, color = object_type)) +
geom_point(alpha = 0.6, size = 1.5) +
scale_color_manual(
values = c("PAYLOAD" = "#00e5ff", "DEBRIS" = "#ff2a6d", "ROCKET BODY" = "#ffb703", "UNKNOWN" = "#8e9bb4")
) +
scale_x_log10(labels = scales::comma) +
labs(
title = "Orbital Velocity vs. Altitude (Keplerian Physics)",
subtitle = expression(v == sqrt(mu / a) ~ "illustrating high collision kinetic velocities in LEO (~7.5 km/s)"),
x = "Altitude (km, Log Scale)",
y = "Orbital Velocity (km/s)",
color = "Category"
) +
theme_space
ggsave("figures/velocity_vs_altitude.png", p4, width = 9, height = 5, dpi = 300)
# ==============================================================================
# 3. Interactive Web Dashboard Export using Plotly
# ==============================================================================
cat("Exporting interactive analytics dashboard HTML...\n")
p1_interactive <- ggplotly(p1)
saveWidget(p1_interactive, "r_analytics_dashboard.html", selfcontained = FALSE)
cat("\nAll analytics plots and reports successfully generated in R!\n")
cat("Generated PNG figures in 'figures/' directory:\n")
cat("- figures/altitude_spatial_density.png\n")
cat("- figures/object_type_breakdown.png\n")
cat("- figures/country_share_distribution.png\n")
cat("- figures/velocity_vs_altitude.png\n")
cat("- r_analytics_dashboard.html (Interactive Plotly Dashboard)\n")
library(shiny); runApp('shiny_dashboard.R')
